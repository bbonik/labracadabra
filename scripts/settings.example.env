# Copy to scripts/settings.env (git-ignored) and fill in. Read by every script in this folder.

# AWS: the SSO profile from ~/.aws/config, the region, and the account the app lives in.
# Scripts refuse to run if you are logged in to a different account.
AWS_PROFILE=labracadabra
AWS_REGION=eu-west-1
AWS_ACCOUNT=123456789012
STACK=Labracadabra

# Deploy settings (scripts/deploy.sh). Keep these the same on every deploy.
AUTH_DOMAIN_PREFIX=lab-xxxxxx          # login page: https://<prefix>.auth.<region>.amazoncognito.com
ALERT_EMAIL=you@example.com            # budget and failure alerts
CIRCLES="family:Family"                # sharing circles, id:Name, comma-separated ("" for none)
INVITER_NAME="Your name"               # shown in invitation emails: "<name> has invited you…"
MONTHLY_BUDGET_USD=10
MAX_PAGES=100                          # longer documents are refused before any model call (cost guard)
REQUIRE_MFA=false                      # true: every member must set up an authenticator app at sign-in
